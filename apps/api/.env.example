# Copy to .env (same folder) and fill in. .env is gitignored and never committed.

# Claude: enables full AI thesis → strategy generation (otherwise a template engine is used)
ANTHROPIC_API_KEY=

# Privy sign-in (same App ID as the web app). Empty = local mode, no sign-in.
PRIVY_APP_ID=
# Privy App Secret: server only (needed for agent wallets / live mode)
PRIVY_APP_SECRET=
# Optional: verification key from the Privy dashboard (otherwise fetched from Privy's JWKS)
# PRIVY_VERIFICATION_KEY=
# AI generations per user per day when sign-in is on
# WEFT_AI_DAILY_LIMIT=30

# Alerts (optional): Telegram bot from @BotFather + your chat id, and/or a webhook (Discord/Slack/Zapier)
# Telegram alerts: create a bot with @BotFather and paste its token. Users connect their own chat in Settings.
TELEGRAM_BOT_TOKEN=
# Optional: one chat that receives every alert (e.g. your own, for monitoring)
TELEGRAM_CHAT_ID=
WEFT_ALERT_WEBHOOK_URL=
# WEFT_ALERT_FILLS=1

# Port (default 8787)
# PORT=8787

# Live trading on Hyperliquid (needs PRIVY_APP_ID + PRIVY_APP_SECRET). Off unless 1.
WEFT_LIVE_ENABLED=0
# testnet (default) or mainnet
WEFT_HL_NETWORK=testnet
# Weft's builder address (receives builder fees; needs >= 100 USDC in perps on Hyperliquid)
WEFT_BUILDER_ADDRESS=
# Builder fee in tenths of a basis point (50 = 5 bps)
# WEFT_BUILDER_FEE_TENTHS_BPS=50
# Safety caps for live deployments
# WEFT_LIVE_MAX_ALLOCATION_USD=100
# WEFT_LIVE_MAX_LEVERAGE=3

# Production
# Web origins allowed to call the API (comma-separated). Unset = any origin (local dev only).
# WEB_ORIGINS=https://weft-tawny.vercel.app,https://weft.trade
# Bind address. Public binds refuse to start without PRIVY_APP_ID.
# HOST=0.0.0.0
# NODE_ENV=production
# Ceiling on one user's open live allocation across all runs (default 5x the per-run cap)
# WEFT_LIVE_MAX_TOTAL_USD=500
