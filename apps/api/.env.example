# Copy to .env (same folder) and fill in. .env is gitignored and never committed.

# Claude: enables full AI thesis → strategy generation (otherwise a template engine is used)
ANTHROPIC_API_KEY=

# Privy sign-in (same App ID as the web app). Empty = local mode, no sign-in.
PRIVY_APP_ID=
# Optional: verification key from the Privy dashboard (otherwise fetched from Privy's JWKS)
# PRIVY_VERIFICATION_KEY=
# AI generations per user per day when sign-in is on
# WEFT_AI_DAILY_LIMIT=30

# Alerts (optional): Telegram bot from @BotFather + your chat id, and/or a webhook (Discord/Slack/Zapier)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEFT_ALERT_WEBHOOK_URL=
# WEFT_ALERT_FILLS=1

# Port (default 8787)
# PORT=8787
