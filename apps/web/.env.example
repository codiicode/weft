# Copy to .env.local (same folder). .env* files are gitignored.

# Privy App ID from dashboard.privy.io (same value as PRIVY_APP_ID in apps/api/.env).
# Empty = local mode: no sign-in, single local user.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: app client id (Privy dashboard → App clients)
# NEXT_PUBLIC_PRIVY_CLIENT_ID=

# API base URL (default http://localhost:8787)
# NEXT_PUBLIC_API_URL=http://localhost:8787
