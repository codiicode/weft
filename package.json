  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "puppeteer-core": "^25.14.0",
    "railway": "^3.16.0"
  }
}
